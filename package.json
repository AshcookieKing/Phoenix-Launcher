{
  "name": "phoenix-launcher",
  "version": "1.1.1",
  "description": "Phoenix Launcher — Arma 3 Star Wars RP",
  "author": "Phoenix",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on http://localhost:5174 && cross-env VITE_DEV_SERVER_URL=http://localhost:5174 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "pack": "vite build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.phoenix.launcher",
    "productName": "PhoenixLauncher",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/assets/phoenix_emblem.png",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "preset",
        "to": "preset"
      }
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "PhoenixLauncher.exe"
    }
  },
  "dependencies": {
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.0.7",
    "wait-on": "^8.0.1"
  }
}
